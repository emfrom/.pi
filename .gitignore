# This repository is an allowlist: only explicitly reviewed configuration is tracked.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/agent/
!/submodules/
/submodules/*
!/submodules/README.md
!/submodules/AGENTS.md
!/submodules/mattpocock-skills
!/submodules/addyosmani-skills
!/submodules/phuryn-skills
!/submodules/openai-skills
!/submodules/emfrom-skills
!/stow/
/stow/*
!/stow/*/

# Keep local skills and non-secret user settings. Stow-created upstream links stay local.
/agent/*
!/agent/settings.json
!/agent/skills/
/agent/skills/*
!/agent/skills/automate-spec/
!/agent/skills/find-skills/
!/agent/skills/implement-serial/
!/agent/skills/manage-pi-skills/

# Local, credential-bearing, or machine-specific Pi state is never published.
/agent/auth.json
/agent/models.json
/agent/models-store.json
/agent/pi-local-connections.json
/agent/trust.json
/agent/memories/
/agent/sessions/
/agent/missions/
/agent/npm/
/agent/install/
/agent/bin/
/agent/extensions/
/agent/agents/
/agent/prompts/
/agent/pi-subagents/
/agent/cc-cli-logs/
/agent/run-history.jsonl
/agent/crashes.json
/agent/*.log

# Exclude the skill that embeds this machine's absolute paths.
/agent/skills/list-directory/

# Defense in depth for sensitive material accidentally added under skills.
/agent/skills/**/.env*
/agent/skills/**/*secret*
/agent/skills/**/*credential*
/agent/skills/**/*.pem
/agent/skills/**/*.key
/agent/skills/**/*token*
